{
  "name": "launch-radar",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs && node tests/apple-flow.browser.mjs && node tests/tmall-flow.browser.mjs && node tests/checkout-recovery.browser.mjs",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=engine/browsers playwright install chromium",
    "build": "bash scripts/build.sh",
    "package": "bash scripts/package.sh",
    "test:bridge": "swift tests/bridge.swift",
    "test:safari": "PLAYWRIGHT_BROWSERS_PATH=engine/browsers node tests/safari.browser.mjs",
    "test:model": "swiftc Sources/LaunchRadar/Model.swift tests/browser-model.swift -o /tmp/launch-radar-model-test && /tmp/launch-radar-model-test"
  },
  "dependencies": {
    "playwright": "1.58.2"
  }
}
